{
  "title": "FlexiTrader Operations",
  "uid": "flexetrader-ops",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Intervals repaired after the LP solve",
      "description": "The LP is solved without the charge/discharge exclusivity constraint and repaired afterwards. Above zero, the published schedule is no longer provably optimal.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flexetrader_lp_repaired_intervals_total[30m])) / clamp_min(sum(rate(flexetrader_lp_intervals_total[30m])), 0.0001)",
          "legendFormat": "repair rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 0.01 },
              { "color": "#d03b3b", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Profit given up to the repair",
      "description": "LP objective minus the profit of the repaired schedule. This is what the linear relaxation costs, in euros.",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(flexetrader_lp_repair_cost_eur_total[1h])",
          "legendFormat": "{{asset}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyEUR", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      }
    },
    {
      "title": "Expected profit of the current schedule",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "flexetrader_schedule_profit_eur",
          "legendFormat": "{{asset}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyEUR", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": []
      }
    },
    {
      "title": "Optimisation cycles by outcome",
      "description": "no_prices means the producer stopped, not that the solver failed.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(flexetrader_optimisation_cycles_total[5m])",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byName", "options": "no_prices" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#fab219" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          }
        ]
      }
    },
    {
      "title": "Optimisation cycle duration",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(flexetrader_optimisation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum(rate(flexetrader_optimisation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0 } },
        "overrides": []
      }
    },
    {
      "title": "Price messages by outcome",
      "description": "A producer sending bad payloads shows up here as a rising validation_error or dead_lettered line long before the schedule looks wrong.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(flexetrader_price_messages_total[5m])",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "inserted" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byName", "options": "dead_lettered" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          }
        ]
      }
    },
    {
      "title": "Message handling time",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(flexetrader_price_message_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0 } },
        "overrides": []
      }
    },
    {
      "title": "Websocket clients",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(flexetrader_websocket_connections)",
          "legendFormat": "connected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }]
          }
        },
        "overrides": []
      }
    }
  ]
}
